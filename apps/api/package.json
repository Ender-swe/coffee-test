{
  "name": "@orlast/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --watch src/server.js",
    "build": "node build.js",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/server.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/auth.js && node --check src/checkout.js && node --check src/db.js && node --check build.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env migrate.js",
    "test:integration": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --test integration/*.test.js"
  },
  "dependencies": {
    "express": "^5.0.0",
    "@orlast/catalog": "*",
    "pg": "^8.0.0",
    "stripe": "^18.0.0",
    "express-rate-limit": "^8.0.0"
  }
}
