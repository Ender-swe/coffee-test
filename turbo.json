{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "HOST",
        "API_URL",
        "DATABASE_URL",
        "WEB_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_AUTOMATIC_TAX",
        "NODE_ENV"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "HOST",
        "API_URL",
        "NODE_ENV",
        "DATABASE_URL",
        "WEB_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_AUTOMATIC_TAX"
      ]
    },
    "check": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
